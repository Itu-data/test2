<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>
<?import javafx.scene.control.Label?>

<AnchorPane xmlns="http://javafx.com/fxml/1"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="com.example.mohapi_parollmanagement_system.ManagerDashboardController">

    <VBox spacing="20" alignment="CENTER"
          AnchorPane.topAnchor="20" AnchorPane.bottomAnchor="20"
          AnchorPane.leftAnchor="20" AnchorPane.rightAnchor="20">

        <Label text="Manager Dashboard" style="-fx-font-size: 24px; -fx-font-weight: bold;"/>

        <Button text="View Team"
                style="-fx-pref-width: 250px; -fx-padding: 10px; -fx-font-size: 14px;"
                onAction="#handleViewTeam"/>

        <Button text="Approve Requests"
                style="-fx-pref-width: 250px; -fx-padding: 10px; -fx-font-size: 14px;"
                onAction="#handleApproveRequests"/>

        <Button text="Performance Metrics"
                style="-fx-pref-width: 250px; -fx-padding: 10px; -fx-font-size: 14px;"
                onAction="#handlePerformanceMetrics"/>

        <Button text="Logout"
                style="-fx-pref-width: 250px; -fx-padding: 10px; -fx-font-size: 14px; -fx-background-color: #ff4444; -fx-text-fill: white;"
                onAction="#handleLogout"/>
    </VBox>
</AnchorPane>