<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.layout.*?>
<?import javafx.scene.control.*?>

<BorderPane xmlns:fx="http://javafx.com/fxml" fx:controller="com.example.mohapi_parollmanagement_system.AdminDashboardController"
            style="-fx-font-family: 'Segoe UI'; -fx-background-color: #ecf0f1;">

    <!-- Sidebar -->
    <left>
        <VBox spacing="15" style="-fx-padding: 20px; -fx-background-color: #2c3e50; -fx-pref-width: 200px;">
            <Label text="Admin Panel"
                   style="-fx-text-fill: white; -fx-font-size: 22px; -fx-font-weight: bold; -fx-padding: 0 0 20 0;"/>
            <Button fx:id="btnDashboard" text="Dashboard" onAction="#handleDashboard"
                    style="-fx-background-color: #34495e; -fx-text-fill: white; -fx-font-size: 14px; -fx-pref-width: 160px;"/>
            <Button fx:id="btnManageEmployees" text="Manage Employees" onAction="#handleManageEmployees"
                    style="-fx-background-color: #34495e; -fx-text-fill: white; -fx-font-size: 14px; -fx-pref-width: 160px;"/>
            <Button fx:id="btnLogout" text="Logout" onAction="#handleLogout"
                    style="-fx-background-color: #e74c3c; -fx-text-fill: white; -fx-font-size: 14px; -fx-pref-width: 160px;"/>
        </VBox>
    </left>

    <!-- Main Content Area -->
    <center>
        <AnchorPane fx:id="contentArea" style="-fx-padding: 20px;"/>
    </center>
</BorderPane>
