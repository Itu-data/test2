<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Button?>
<AnchorPane xmlns="http://javafx.com/javafx"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="com.example.mohapi_parollmanagement_system.Payroll"
            prefHeight="400.0" prefWidth="600.0">

    <Label layoutX="50" layoutY="30" text="Employee ID:"/>
    <TextField fx:id="employeeIdField" layoutX="150" layoutY="25"/>

    <Label layoutX="50" layoutY="80" text="Overtime:"/>
    <TextField fx:id="overtimeField" layoutX="150" layoutY="75"/>

    <Label layoutX="50" layoutY="130" text="Deductions:"/>
    <TextField fx:id="deductionsField" layoutX="150" layoutY="125"/>

    <Button layoutX="150" layoutY="180" text="Calculate Payroll" onAction="#handleCalculatePayroll"/>
    <Label fx:id="statusLabel" layoutX="150" layoutY="230"/>

</AnchorPane>
