<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.layout.*?>
<?import javafx.scene.control.*?>

<AnchorPane xmlns:fx="http://javafx.com/fxml" fx:controller="com.example.mohapi_parollmanagement_system.ManageEmployeesController">
    <children>
        <!-- Add Employee Form -->
        <VBox spacing="15" style="-fx-padding: 20px;">
            <TextField fx:id="nameField" promptText="Enter Employee Name"/>
            <TextField fx:id="departmentField" promptText="Enter Department"/>
            <TextField fx:id="positionField" promptText="Enter Position"/>
            <Button text="Add Employee" onAction="#handleAddEmployee"/>
        </VBox>

        <!-- Employee Table -->
        <TableView fx:id="employeeTable" layoutX="300.0" layoutY="100.0" prefWidth="600.0" prefHeight="300.0">
            <columns>
                <TableColumn text="ID" fx:id="idColumn" />
                <TableColumn text="Name" fx:id="nameColumn" />
                <TableColumn text="Department" fx:id="departmentColumn" />
                <TableColumn text="Position" fx:id="positionColumn" />
            </columns>
        </TableView>
    </children>
</AnchorPane>
