<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<AnchorPane xmlns:fx="http://javafx.com/fxml" fx:controller="com.example.mohapi_parollmanagement_system.SignupController">
    <children>
        <VBox alignment="CENTER" spacing="10.0" prefWidth="300" AnchorPane.leftAnchor="0" AnchorPane.rightAnchor="0" AnchorPane.topAnchor="0" AnchorPane.bottomAnchor="0">
            <Label text="Create Account" style="-fx-font-size: 18px; -fx-font-weight: bold; -fx-padding: 0 0 10 0;"/>
            <VBox alignment="CENTER_LEFT" spacing="5.0" style="-fx-padding: 10px; -fx-background-color: white; -fx-background-radius: 5px;">
                <Label text="Username:"/>
                <TextField fx:id="usernameField" promptText="Choose username" style="-fx-pref-width: 250px; -fx-padding: 5px;"/>
                <Label text="Password:"/>
                <PasswordField fx:id="passwordField" promptText="Enter password" style="-fx-pref-width: 250px; -fx-padding: 5px;"/>
                <Label text="Confirm Password:"/>
                <PasswordField fx:id="confirmPasswordField" promptText="Re-enter password" style="-fx-pref-width: 250px; -fx-padding: 5px;"/>
                <Button text="Sign Up" onAction="#handleSignup" style="-fx-pref-width: 250px; -fx-background-color: #4CAF50; -fx-text-fill: white; -fx-padding: 8px;"/>
                <Button text="Back to Login" onAction="#goToLogin" style="-fx-pref-width: 250px; -fx-background-color: #9E9E9E; -fx-text-fill: white; -fx-padding: 8px;"/>
            </VBox>
        </VBox>
    </children>
</AnchorPane>